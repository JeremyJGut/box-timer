{
  "name": "box-timer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "dev:emu": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:rules": "firebase emulators:exec --only auth,firestore \"node scripts/rules-test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
